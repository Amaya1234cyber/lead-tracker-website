{
  "manifest_version": 3,
  "name": "Lead Tracker",
  "short_name": "Lead Tracker",
  "version": "2.0.0",
  "description": "Save, organize, search, and export useful leads and web pages.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Open Lead Tracker",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
